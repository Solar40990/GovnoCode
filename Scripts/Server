local missingPeripherals = {}

local modem = peripheral.find("modem")
if not modem then table.insert(missingPeripherals,"modem")end

local chatBox = peripheral.find("chat_box")
if not chatBox then table.insert(missingPeripherals,"chatbox") end

local speakers = {peripheral.find("speaker")}
if #speakers < 2 then table.insert(missingPeripherals,"speaker "..tostring(2-#speakers)) end

if #missingPeripherals > 0 then
    error("Some of peripherals are missing: "..table.concat(missingPeripherals,","))
end

local speakerAudio = speakers[1]
local speakerSound = speakers[2]

modem.open(6)

term.clear()
term.setCursorPos(1,1)
print("Successfully started system!")

local binds = {
    playSound = function (info)
        local sound = info.sound
        local volume = info.volume or 1
        local pitch = info.pitch or 1
        speakerSound.playSound(sound,volume,pitch)
    end,
    narrateMessage = function (info)
        local text = info.text or "error"
        local args = info.args or {utf8 = true}

        chatBox.narrateMessage(text,args)
    end,
    playAudio = function (info)
        os.queueEvent("stopAudio")
        os.queueEvent("playAudio",info.audio)
    end,
    stopAudio = function ()
        os.queueEvent("stopAudio")
    end,
    getAudio = function (info)
        local audioList = fs.list("music")
        for i,name in pairs(audioList) do
            audioList[i] = name:match("([^.]+)")
        end
        modem.transmit(info.replyChannel,6,{audioList = audioList})
    end
}

parallel.waitForAll(
    function ()
        while true do
            local _,_,channel,_,message = os.pullEvent("modem_message")
            if channel == 6 then
                if binds[message.type] then binds[message.type](message.info) end
            end
        end
    end,
    function ()
        local dfpwm = require("cc.audio.dfpwm")
        local decoder = dfpwm.make_decoder()
        while true do
            local _,audio = os.pullEvent("playAudio")
            parallel.waitForAny(
                function ()
                    for chunk in io.lines(audio,8 * 1024) do
                        local buffer = decoder(chunk)

                        while not speakerAudio.playAudio(buffer) do
                            os.pullEvent("speaker_audio_empty")
                        end
                    end
                end,
                function ()
                    os.pullEvent("stopAudio")
                    speakerAudio.stop()
                end
            )  
        end
    end
)

speakerSound.playSound("entity.experience_orb.pickup")